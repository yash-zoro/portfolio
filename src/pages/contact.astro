---
import BaseLayout from "../layouts/BaseLayout.astro";

const channels = [
  {
    label: "Email",
    value: "yashkant1125@gmail.com",
    href: "mailto:yashkant1125@gmail.com",
    external: false,
    icon: "M21.75 6.75v10.5A2.25 2.25 0 0 1 19.5 19.5H4.5A2.25 2.25 0 0 1 2.25 17.25V6.75A2.25 2.25 0 0 1 4.5 4.5h15a2.25 2.25 0 0 1 2.25 2.25zM3.75 7.5l7.125 4.95a.75.75 0 0 0 .75 0L18.75 7.5",
  },
  {
    label: "LinkedIn",
    value: "in/yash-2511-kant",
    href: "https://www.linkedin.com/in/yash-2511-kant/",
    external: true,
    iconFill: "M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8.5h4V24h-4V8.5zM8.5 8.5h3.75v2.1h.05c.52-.97 1.79-2 3.68-2 3.93 0 4.65 2.6 4.65 5.98V24h-4v-8.25c0-1.97-.04-4.5-2.75-4.5-2.76 0-3.18 2.14-3.18 4.35V24h-4V8.5z",
  },
  {
    label: "X (Twitter)",
    value: "@zorrrrrroooooo",
    href: "https://x.com/zorrrrrroooooo",
    external: true,
    iconFill: "M22.25 2 14.8 9.25 23.5 22h-6.3l-5.25-7.5-7.6 7.5H.5l8.3-8-7.8-11h6.4l4.8 6.9L20.75 2h1.5z",
  },
];
---

<BaseLayout title="Contact — Yash Kant">
  <section class="py-16 max-w-2xl">
    <p class="mono-label">// get in touch</p>
    <h1 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight">Let's talk</h1>
    <p class="mt-4 text-lg text-ink/70 leading-relaxed">
      Security work, an opportunity, or just comparing notes on the SOC &mdash; my inbox is open.
      Best reached over email or LinkedIn.
    </p>

    <div class="mt-10 space-y-3 stagger-in">
      {channels.map((c) => (
        <a
          href={c.href}
          target={c.external ? "_blank" : undefined}
          rel={c.external ? "noopener noreferrer" : undefined}
          class="glass glass-hover group flex items-center gap-4 p-4"
        >
          <span class="grid place-items-center w-10 h-10 rounded-lg bg-em/10 text-em shrink-0">
            {c.iconFill ? (
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d={c.iconFill} /></svg>
            ) : (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={c.icon} /></svg>
            )}
          </span>
          <span class="flex-1 min-w-0">
            <span class="block text-sm font-medium text-ink group-hover:text-em transition-colors">{c.label}</span>
            <span class="block font-mono text-xs text-mut truncate">{c.value}</span>
          </span>
          <svg class="w-4 h-4 text-mut group-hover:text-em transition-colors shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
